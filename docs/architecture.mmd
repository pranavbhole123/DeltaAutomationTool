flowchart TD
    json["Selected JSON rule file<br/>Inputs · sources · routes · selectors<br/>Derivations · operations · comparison_file link"]
    policies["Companion comparison JSON<br/>File IDs · list normalization · XML identity<br/>Latest-content scope · conditional exclusions"]
    load["spec.py + schema.py<br/>Version/grammar/reference/cycle validation<br/>No pack-name or rule-ID dispatch"]
    inputs["gui.py / cli.py → config.py<br/>Dynamic project inputs + P4 connection<br/>expressions.py: derive values and eligibility"]
    resolve["resolver.py<br/>Declared routes → effective View/root coverage<br/>Exact file / bounded tree queries"]
    pure["operations.py + reference.py + transforms.py + json_ops.py<br/>Reusable Make · init · XML · JSON · text operations"]
    plan["planner.py<br/>Read pinned revisions · execute rule steps<br/>Accumulate edits · roll back failed rule"]
    output["Sealed normal plan<br/>Checks · evidence · before/after bytes · diff<br/>Review tab + saved plan.json / plan.txt"]
    preview["Inspection-only previews + requirements<br/>Same interpreter in blank.py mode<br/>Saved preview · no target-content reads in blank mode"]
    compare["comparison.py + comparison_report.py<br/>Selected CL edits + latest target content<br/>Additions / required removals / extra changes<br/>Saved comparison.json / comparison.txt"]
    approval["User reviews exact plan and acknowledges findings"]
    apply["executor.py<br/>Verify digest, identity, Views, revisions and local state<br/>Create pending CL · write verified bytes · journal<br/>Never auto-shelve or submit"]
    p4["perforce.py<br/>p4 CLI + existing login ticket<br/>Read calls during plan/compare; write calls only during apply"]
    json --> load --> inputs --> resolve --> plan
    policies --> load
    pure --> plan
    plan --> output --> approval --> apply
    plan --> preview --> compare
    resolve -. reads .-> p4
    plan -. reads .-> p4
    compare -. reads .-> p4
    apply -. validates and writes .-> p4
