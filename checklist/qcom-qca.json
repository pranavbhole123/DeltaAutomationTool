  "rules": [
    {
      "id": "vendor.board",
      "title": "Reference Bluetooth and WLAN board settings",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B3:B4"
      },
      "steps": [
        {
          "op": "make.ensure",
          "from": {
            "file": "reference.vendor.board"
          },
          "to": {
            "file": "current.vendor.board"
          },
          "select": {
            "assignment_names": [
              "WLAN_VENDOR",
              "WLAN_CHIP",
              "BOARD_HAVE_BLUETOOTH",
              "BOARD_HAS_QCA_BT_ROME",
              "BOARD_HAVE_BLUETOOTH_QCOM",
              "WCNSS_FILTER_USES_SIBS",
              "BUILD_BT_WCNSS",
              "BOARD_HAS_QCA_BT_ROME_PCM_SLAVE",
              "BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR"
            ],
            "comment_patterns": [
              "(?i)^\\s*#+\\s*(?:bluetooth|bt)(?:\\b|_)"
            ],
            "exclude": [
              {
                "within": "ifeq.*SEC_PRODUCT_FEATURE_BLUETOOTH_SUPPORT_A2DP_OFFLOAD",
                "assignment_names": [
                  "TARGET_HAS_SPLIT_A2DP_FEATURE",
                  "TARGET_HAS_BTHOST_IPC",
                  "SEC_BT_DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE"
                ],
                "patterns": [
                  "^\\$\\(eval\\s+\\$\\(call\\s+add-device-manifest,\\s*vendor/samsung/interfaces/bluetooth/a2dp/1\\.0/manifest\\.xml\\)\\)$"
                ],
                "variable": "DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE",
                "member_names": [
                  "$(SEC_BT_DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE)"
                ]
              },
              {
                "assignment_names": [
                  "BOARD_HAVE_ANT_WIRELESS",
                  "BOARD_ANT_WIRELESS_DEVICE"
                ]
              }
            ],
            "include_basenames": [
              "BluetoothBoardConfigCommon.mk"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ]
    },
    {
      "id": "vendor.ant_board",
      "title": "Reference ANT board support",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B5"
      },
      "steps": [
        {
          "op": "make.ensure",
          "from": {
            "file": "reference.vendor.board"
          },
          "to": {
            "file": "current.vendor.board"
          },
          "select": {
            "assignment_names": [
              "BOARD_HAVE_ANT_WIRELESS",
              "BOARD_ANT_WIRELESS_DEVICE"
            ],
            "comment_patterns": [
              "(?i)^\\s*#+\\s*ant(?:\\b|_)"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ],
      "when": {
        "var": "ant.enabled"
      }
    },
    {
      "id": "vendor.offload_board",
      "title": "Remove A2DP offload settings",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B6"
      },
      "steps": [
        {
          "op": "make.remove",
          "to": {
            "file": "current.vendor.board"
          },
          "select": {
            "within": "ifeq.*SEC_PRODUCT_FEATURE_BLUETOOTH_SUPPORT_A2DP_OFFLOAD",
            "assignment_names": [
              "TARGET_HAS_SPLIT_A2DP_FEATURE",
              "TARGET_HAS_BTHOST_IPC",
              "SEC_BT_DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE"
            ],
            "patterns": [
              "^\\$\\(eval\\s+\\$\\(call\\s+add-device-manifest,\\s*vendor/samsung/interfaces/bluetooth/a2dp/1\\.0/manifest\\.xml\\)\\)$"
            ],
            "variable": "DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE",
            "member_names": [
              "$(SEC_BT_DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE)"
            ]
          }
        }
      ]
    },
    {
      "id": "vendor.packages",
      "title": "Reference Bluetooth packages",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B8"
      },
      "steps": [
        {
          "op": "make.content",
          "from": {
            "file": "reference.vendor.packages"
          },
          "to": {
            "file": "current.vendor.packages"
          },
          "select": {
            "comment_patterns": [
              "(?i)^\\s*#+\\s*(?:bluetooth|bt)(?:\\b|_)"
            ],
            "packages": {
              "variable": "PRODUCT_PACKAGES",
              "names": [
                "android.hardware.bluetooth@1.0-service-qti",
                "android.hardware.bluetooth@1.0-impl-qti",
                "android.hardware.bluetooth@1.0-service-qti.rc",
                "BluetoothAgent"
              ]
            },
            "includes": {
              "patterns": [
                "(?i)^-?include\\s+.*(?:bluetooth|(?:^|[/_])bt(?:[/_.]|$))"
              ]
            },
            "exclude": [
              {
                "variable": "PRODUCT_PACKAGES",
                "member_names": [
                  "vendor.samsung.hardware.bluetooth.a2dp@1.0-impl",
                  "libbthost_if"
                ],
                "within": "ifeq.*SEC_PRODUCT_FEATURE_BLUETOOTH_SUPPORT_A2DP_OFFLOAD"
              },
              {
                "lines": [
                  "include device/samsung/${reference.common}/Bluetooth/Bluetooth.mk"
                ]
              },
              {
                "variable": "PRODUCT_PACKAGES",
                "member_names": [
                  "com.dsi.ant.antradio_library",
                  "com.dsi.ant.antradio_library.xml",
                  "com.qualcomm.qti.ant@1.0-impl",
                  "com.qualcomm.qti.ant@1.0",
                  "com.qualcomm.qti.ant@1.0_vendor",
                  "AntHalService",
                  "ANTPlusPlugins",
                  "ANTRadioService",
                  "ANTPlusTest"
                ]
              }
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ]
    },
    {
      "id": "vendor.ant_packages",
      "title": "Reference ANT packages",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B9"
      },
      "steps": [
        {
          "op": "make.packages",
          "from": {
            "file": "reference.vendor.packages"
          },
          "to": {
            "file": "current.vendor.packages"
          },
          "select": {
            "variable": "PRODUCT_PACKAGES",
            "names": [
              "com.dsi.ant.antradio_library",
              "com.dsi.ant.antradio_library.xml",
              "com.qualcomm.qti.ant@1.0-impl",
              "com.qualcomm.qti.ant@1.0",
              "com.qualcomm.qti.ant@1.0_vendor",
              "AntHalService",
              "ANTPlusPlugins",
              "ANTRadioService",
              "ANTPlusTest"
            ],
            "comment_patterns": [
              "(?i)^\\s*#+\\s*ant(?:\\b|_)"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ],
      "when": {
        "var": "ant.enabled"
      }
    },
    {
      "id": "vendor.offload_packages",
      "title": "Remove A2DP offload packages",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B10"
      },
      "steps": [
        {
          "op": "make.remove",
          "to": {
            "file": "current.vendor.packages"
          },
          "select": {
            "variable": "PRODUCT_PACKAGES",
            "member_names": [
              "vendor.samsung.hardware.bluetooth.a2dp@1.0-impl",
              "libbthost_if"
            ],
            "within": "ifeq.*SEC_PRODUCT_FEATURE_BLUETOOTH_SUPPORT_A2DP_OFFLOAD"
          }
        }
      ]
    },
    {
      "id": "vendor.legacy_include",
      "title": "Remove legacy model Bluetooth include",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B11"
      },
      "steps": [
        {
          "op": "make.remove",
          "to": {
            "file": "current.vendor.packages"
          },
          "select": {
            "lines": [
              "include device/samsung/${current.common}/Bluetooth/Bluetooth.mk"
            ]
          }
        }
      ]
    },
    {
      "id": "vendor.header",
      "title": "Copy missing reference build header",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B13"
      },
      "steps": [
        {
          "op": "file.copy_if_missing",
          "from": {
            "file": "reference.vendor.header"
          },
          "to": {
            "file": "current.vendor.header"
          },
          "policy": {
            "on_source_missing": "skip"
          },
          "pairing": {
            "method": "view_relative",
            "replacements": [
              [
                {
                  "var": "reference.common"
                },
                {
                  "var": "current.common"
                }
              ],
              [
                {
                  "var": "reference.model"
                },
                {
                  "var": "current.model"
                }
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "vendor.header_define",
      "title": "Ensure Qualcomm header define",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B13"
      },
      "steps": [
        {
          "op": "text.ensure",
          "to": {
            "file": "current.vendor.header"
          },
          "literal": [
            "#define BOARD_HAVE_BLUETOOTH_QCOM TRUE"
          ],
          "policy": {
            "on_target_missing": "review",
            "on_value_difference": "replace"
          },
          "select": {
            "identity_pattern": "^#\\s*define\\s+(BOARD_HAVE_BLUETOOTH_QCOM)\\b"
          }
        }
      ]
    },
    {
      "id": "audio.validation",
      "title": "Manual checklist verification",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "C13"
      },
      "steps": [
        {
          "op": "manual",
          "message": "Confirm ESCO_DATA_PATH_INTERFACE I2S/PCM with BT_Audio and verify firmware major/minor versions from its history; neither can be established by copying a header."
        }
      ]
    },
    {
      "id": "vendor.features",
      "title": "Reference Bluetooth product features",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B15"
      },
      "steps": [
        {
          "op": "make.values",
          "from": {
            "file": "reference.vendor.features"
          },
          "to": {
            "file": "current.vendor.features"
          },
          "select": {
            "prefix": "SEC_PRODUCT_FEATURE_BLUETOOTH_",
            "comment_patterns": [
              "(?i)^\\s*#+\\s*(?:bluetooth|bt)(?:\\b|_)"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          },
          "operator": "="
        }
      ]
    },
    {
      "id": "floating.features",
      "title": "Manual checklist verification",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B15"
      },
      "steps": [
        {
          "op": "manual",
          "message": "Verify model-specific FloatingFeature flags with previous OS; the worksheet supplies no exact file or flag values."
        }
      ]
    },
    {
      "id": "vendor.init",
      "title": "Reference init commands and permissions",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B17"
      },
      "steps": [
        {
          "op": "init.ensure",
          "from": {
            "file": "reference.vendor.init"
          },
          "to": {
            "file": "current.vendor.init"
          },
          "select": {
            "command_patterns": [
              "(?i)bluetooth|ro\\.bt\\.|/sys/class/rfkill/"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review",
            "context_patterns": [
              "(?i)bluetooth|bluedroid|\\bBT\\b"
            ]
          }
        }
      ]
    },
    {
      "id": "vendor.slsi_init",
      "title": "SLSI AP dump and power commands",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B17"
      },
      "steps": [
        {
          "op": "init.ensure",
          "from": {
            "file": "reference.vendor.init"
          },
          "to": {
            "file": "current.vendor.init"
          },
          "select": {
            "command_patterns": [
              "/dev/btpower|/data/vendor/ssrdump"
            ]
          },
          "policy": {
            "context_patterns": [
              "(?i)bluetooth|\\bBT\\b"
            ]
          }
        }
      ],
      "when": {
        "eq": [
          {
            "input": "slsi_ap"
          },
          "yes"
        ]
      }
    },
    {
      "id": "vendor.slsi_eligibility",
      "title": "Resolve SLSI AP eligibility",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B17"
      },
      "steps": [
        {
          "op": "manual",
          "status": "review",
          "message": "Select whether the AP is SLSI before checking the B17 btpower/ssrdump commands."
        }
      ],
      "when": {
        "eq": [
          {
            "input": "slsi_ap"
          },
          "unknown"
        ]
      }
    },
    {
      "id": "vendor.qti_stack",
      "title": "Remove Qualcomm Bluetooth stack selections",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B19"
      },
      "steps": [
        {
          "op": "make.remove",
          "to": {
            "file": "current.vendor.base"
          },
          "select": {
            "assignment_names": [
              "TARGET_USE_QTI_BT_STACK"
            ],
            "variable": "BT",
            "member_names": [
              "libbluetooth_qti"
            ]
          }
        },
        {
          "op": "text.remove",
          "to": {
            "file": "current.vendor.props"
          },
          "select": {
            "patterns": [
              "^ro\\.bluetooth\\.library_name\\s*=\\s*libbluetooth_qti\\.so$"
            ]
          }
        }
      ]
    },
    {
      "id": "device.validation",
      "title": "Manual checklist verification",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B21:C21"
      },
      "steps": [
        {
          "op": "manual",
          "message": "On a built phone check firmware with *#2663# and ANT+ with *#533882#; firmware rules check mapped file presence only."
        }
      ]
    },
    {
      "id": "gpio.validation",
      "title": "Manual checklist verification",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B23"
      },
      "steps": [
        {
          "op": "manual",
          "message": "GPIO files are named as examples, without pin assignments or a patch. Review the model pinctrl / board DTS / gpio DTSI with the hardware owner; no automatic edit is specified."
        }
      ]
    },
    {
      "id": "vendor.voltage",
      "title": "Ensure config_bluetooth_operating_voltage_mv",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B25:C25"
      },
      "steps": [
        {
          "op": "xml.ensure",
          "to": {
            "file": "current.vendor.overlay"
          },
          "literal": "<resources><integer name=\"config_bluetooth_operating_voltage_mv\" translatable=\"false\">3700</integer></resources>",
          "select": {
            "path": "./integer",
            "name_path": "@name",
            "names": [
              "config_bluetooth_operating_voltage_mv"
            ]
          },
          "identity": [
            "@name"
          ],
          "root": "resources",
          "policy": {
            "on_value_difference": "replace",
            "on_target_missing": "create"
          }
        }
      ]
    },
    {
      "id": "vendor.manifest",
      "title": "Ensure ISehBluetooth manifest",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B27:C27"
      },
      "steps": [
        {
          "op": "xml.ensure",
          "to": {
            "file": "current.vendor.manifest"
          },
          "literal": "<manifest><hal format=\"hidl\" override=\"true\"><name>vendor.samsung.hardware.bluetooth</name><transport>hwbinder</transport><version>2.0</version><interface><name>ISehBluetooth</name><instance>default</instance></interface></hal></manifest>",
          "select": {
            "path": ".//hal",
            "name_path": "name",
            "names": [
              "vendor.samsung.hardware.bluetooth"
            ]
          },
          "identity": [
            "name",
            "@format"
          ],
          "policy": {
            "on_value_difference": "review"
          }
        }
      ]
    },
    {
      "id": "vendor.matrix",
      "title": "Ensure ISehBluetooth matrix",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B27:C27"
      },
      "steps": [
        {
          "op": "xml.ensure",
          "to": {
            "file": "current.vendor.matrix"
          },
          "literal": "<compatibility-matrix><hal format=\"hidl\" optional=\"true\"><name>vendor.samsung.hardware.bluetooth</name><version>2.0</version><interface><name>ISehBluetooth</name><instance>default</instance></interface></hal></compatibility-matrix>",
          "select": {
            "path": ".//hal",
            "name_path": "name",
            "names": [
              "vendor.samsung.hardware.bluetooth"
            ]
          },
          "identity": [
            "name",
            "@format"
          ],
          "policy": {
            "on_value_difference": "review"
          }
        }
      ]
    },
    {
      "id": "vendor.hearing_aid",
      "title": "Ensure config_hearing_aid_profile_supported",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B29:C29"
      },
      "steps": [
        {
          "op": "xml.ensure",
          "to": {
            "file": "current.vendor.overlay"
          },
          "literal": "<resources><bool name=\"config_hearing_aid_profile_supported\">true</bool></resources>",
          "select": {
            "path": "./bool",
            "name_path": "@name",
            "names": [
              "config_hearing_aid_profile_supported"
            ]
          },
          "identity": [
            "@name"
          ],
          "root": "resources",
          "policy": {
            "on_value_difference": "replace",
            "on_target_missing": "create"
          }
        }
      ],
      "when": {
        "var": "hearing.enabled"
      }
    },
    {
      "id": "kernel.hid",
      "title": "Manual checklist verification",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "B31:C31"
      },
      "steps": [
        {
          "op": "manual",
          "message": "Inspect the mapped kernel drivers/hid/hid-apple.c and obtain CL 22749548. The worksheet does not include the lines to remove; a kernel patch cannot be inferred."
        }
      ]
    },
    {
      "id": "vendor.firmware",
      "title": "Verify mapped firmware path exists",
      "provenance": {
        "sheet": "QCOM-QCA",
        "range": "C21"
      },
      "steps": [
        {
          "op": "file.exists",
          "to": {
            "file": "current.vendor.firmware"
          },
          "message": "Mapped firmware file exists. This check does not read or compare firmware contents or versions.",
          "assert_path": {
            "var": "current.firmware"
          }
        }
      ]
    }
  ],
  "report": {
    "title": "QCOM-QCA Delta report",
    "changelist": "QCOM-QCA delta for ${current.model}"
  },
  "comparison_file": "qcom-qca.comparison.json"
}
