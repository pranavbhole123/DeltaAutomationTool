{
  "schema_version": 2,
  "id": "qcom-qca",
  "title": "QCOM-QCA Bluetooth Delta",
  "source": "159551_BT Delta Checklist.xlsx / QCOM-QCA",
  "inputs": {
    "reference.vendor_template": {
      "type": "string",
      "label": "Reference vendor template",
      "required": true
    },
    "current.vendor_template": {
      "type": "string",
      "label": "Current vendor template",
      "required": true
    },
    "model": {
      "type": "string",
      "label": "Reference model (also current when log is blank)",
      "required": true,
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "radio_chip": {
      "type": "string",
      "label": "WLAN / Bluetooth chip (optional; infer from reference)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "current_log_path": {
      "type": "path",
      "label": "Current vendor build log (optional)",
      "default": ""
    },
    "board_platform": {
      "type": "string",
      "label": "AP / target board (optional; infer from reference)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "current_board_platform": {
      "type": "string",
      "label": "Current target board override (optional)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "ant_support": {
      "type": "choice",
      "label": "ANT+ eligibility",
      "choices": [
        "infer",
        "enabled",
        "disabled"
      ],
      "default": "infer",
      "help": "Infer uses reference BOARD_ANT_WIRELESS_DEVICE support. Unresolved eligibility requires review."
    },
    "jdm": {
      "type": "boolean",
      "label": "JDM",
      "default": false
    },
    "slsi_ap": {
      "type": "choice",
      "label": "AP is SLSI",
      "choices": [
        "unknown",
        "yes",
        "no"
      ],
      "default": "unknown"
    },
    "hearing_aid": {
      "type": "choice",
      "label": "Hearing aid eligibility",
      "choices": [
        "infer",
        "enabled",
        "disabled"
      ],
      "default": "infer"
    }
  },
  "sources": {
    "reference.vendor": {
      "kind": "template",
      "input": "reference.vendor_template",
      "role": "reference"
    },
    "current.vendor": {
      "kind": "template",
      "input": "current.vendor_template",
      "role": "current"
    }
  },
  "lookups": {
    "firmware": {
      "qca6174": "btfw32.tlv",
      "qca9377": "rampatch_tlv_tf_1.1.tlv"
    }
  },
  "derive": {
    "reference.model": {
      "value": {
        "input": "model"
      }
    },
    "log.model": {
      "value": {
        "log": {
          "input": "current_log_path",
          "label": "TARGET",
          "pattern": "(?im)^\\s*TARGET\\s*:\\s*(.*?)\\s*$",
          "destination": "current model"
        }
      },
      "export": "current.build_log_inputs.model"
    },
    "log.board": {
      "value": {
        "log": {
          "input": "current_log_path",
          "label": "target_board",
          "pattern": "(?im)^\\s*(?:target_board|TARGET_BOARD_PLATFORM)\\s*[:=]\\s*(.*?)\\s*$",
          "destination": "current AP folder"
        }
      },
      "export": "current.build_log_inputs.board_platform"
    },
    "current.model": {
      "value": {
        "coalesce": [
          {
            "var": "log.model"
          },
          {
            "var": "reference.model"
          }
        ]
      }
    },
    "reference.common": {
      "value": {
        "template": "${reference.model}_common"
      }
    },
    "current.common": {
      "value": {
        "template": "${current.model}_common"
      }
    },
    "reference.chip": {
      "value": {
        "lower": {
          "coalesce": [
            {
              "input": "radio_chip"
            },
            {
              "assignment": {
                "file": "reference.vendor.board",
                "key": "WLAN_CHIP"
              }
            }
          ]
        }
      }
    },
    "current.chip": {
      "value": {
        "var": "reference.chip"
      }
    },
    "reference.ap": {
      "value": {
        "lower": {
          "coalesce": [
            {
              "input": "board_platform"
            },
            {
              "assignment": {
                "file": "reference.vendor.board",
                "key": "TARGET_BOARD_PLATFORM"
              }
            }
          ]
        }
      }
    },
    "current.ap": {
      "value": {
        "coalesce": [
          {
            "input": "current_board_platform"
          },
          {
            "var": "log.board"
          },
          {
            "var": "reference.ap"
          }
        ]
      }
    },
    "current.firmware": {
      "value": {
        "lookup": {
          "table": "firmware",
          "key": {
            "var": "current.chip"
          }
        }
      }
    },
    "ant.enabled": {
      "value": {
        "if": {
          "eq": [
            {
              "input": "ant_support"
            },
            "infer"
          ]
        },
        "then": {
          "eq": [
            {
              "lower": {
                "assignment": {
                  "file": "reference.vendor.board",
                  "key": "BOARD_ANT_WIRELESS_DEVICE"
                }
              }
            },
            "qualcomm-uart"
          ]
        },
        "else": {
          "eq": [
            {
              "input": "ant_support"
            },
            "enabled"
          ]
        }
      }
    },
    "hearing.enabled": {
      "value": {
        "if": {
          "any": [
            {
              "input": "jdm"
            },
            {
              "eq": [
                {
                  "lower": {
                    "var": "current.ap"
                  }
                },
                "msm8998"
              ]
            }
          ]
        },
        "then": false,
        "else": {
          "if": {
            "eq": [
              {
                "input": "hearing_aid"
              },
              "infer"
            ]
          },
          "then": {
            "if": {
              "present": {
                "var": "current.ap"
              }
            },
            "then": true,
            "else": null
          },
          "else": {
            "eq": [
              {
                "input": "hearing_aid"
              },
              "enabled"
            ]
          }
        }
      }
    }
  },
  "files": {
    "reference.vendor.board": {
      "source": "reference.vendor",
      "kind": "file",
      "format": "make",
      "routes": [
        {
          "client_relative": "android/device/samsung/${reference.common}/BoardConfigCommon.mk"
        },
        {
          "anchor_regex": "/Combination/[^/]+/",
          "relative": "${reference.model}_vendor/device/${reference.common}/BoardConfigCommon.mk"
        },
        {
          "anchor_regex": "/Combination/[^/]+/",
          "relative": "model/${reference.model}/device/${reference.common}/BoardConfigCommon.mk"
        },
        {
          "anchor_regex": "/EXYNOS[0-9]*/",
          "relative": "model/${reference.model}/device/${reference.common}/BoardConfigCommon.mk"
        }
      ]
    },
