{
  "schema_version": 2,
  "id": "qcom-wcn",
  "title": "QCOM-WCN Bluetooth Delta",
  "source": "159551_BT Delta Checklist.xlsx / QCOM-WCN",
  "inputs": {
    "reference.system_template": {
      "type": "string",
      "label": "Reference system template",
      "required": true
    },
    "reference.vendor_template": {
      "type": "string",
      "label": "Reference vendor template",
      "required": true
    },
    "current.system_template": {
      "type": "string",
      "label": "Current system template",
      "required": true
    },
    "current.vendor_template": {
      "type": "string",
      "label": "Current vendor template",
      "required": true
    },
    "model": {
      "type": "string",
      "label": "Reference model (also current when log is blank)",
      "required": true,
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "radio_chip": {
      "type": "string",
      "label": "WLAN / Bluetooth chip (optional; infer from reference)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "current_log_path": {
      "type": "path",
      "label": "Current vendor build log (optional)",
      "default": ""
    },
    "board_platform": {
      "type": "string",
      "label": "AP / target board (optional; infer from reference)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    },
    "current_board_platform": {
      "type": "string",
      "label": "Current target board override (optional)",
      "default": "",
      "pattern": "[A-Za-z0-9_.-]+"
    }
  },
  "sources": {
    "reference.system": {
      "kind": "template",
      "input": "reference.system_template",
      "role": "reference"
    },
    "reference.vendor": {
      "kind": "template",
      "input": "reference.vendor_template",
      "role": "reference"
    },
    "current.system": {
      "kind": "template",
      "input": "current.system_template",
      "role": "current"
    },
    "current.vendor": {
      "kind": "template",
      "input": "current.vendor_template",
      "role": "current"
    }
  },
  "lookups": {
    "firmware": {
      "wcn6750": "msbtfw11.tlv",
      "wcn6755": "msbtfw12.tlv",
      "wcn6850": "hpbtfw10.tlv",
      "wcn6856": "hpbtfw21.tlv",
      "wcn7851": "hmtbtfw20.tlv",
      "wcn3990": "apbtfw11.tlv"
    }
  },
  "derive": {
    "reference.model": {
      "value": {
        "input": "model"
      }
    },
    "log.model": {
      "value": {
        "log": {
          "input": "current_log_path",
          "label": "TARGET",
          "pattern": "(?im)^\\s*TARGET\\s*:\\s*(.*?)\\s*$",
          "destination": "current model"
        }
      },
      "export": "current.build_log_inputs.model"
    },
    "log.board": {
      "value": {
        "log": {
          "input": "current_log_path",
          "label": "target_board",
          "pattern": "(?im)^\\s*(?:target_board|TARGET_BOARD_PLATFORM)\\s*[:=]\\s*(.*?)\\s*$",
          "destination": "current AP folder"
        }
      },
      "export": "current.build_log_inputs.board_platform"
    },
    "current.model": {
      "value": {
        "coalesce": [
          {
            "var": "log.model"
          },
          {
            "var": "reference.model"
          }
        ]
      }
    },
    "reference.common": {
      "value": {
        "template": "${reference.model}_common"
      }
    },
    "current.common": {
      "value": {
        "template": "${current.model}_common"
      }
    },
    "reference.chip": {
      "value": {
        "lower": {
          "coalesce": [
            {
              "input": "radio_chip"
            },
            {
              "assignment": {
                "file": "reference.vendor.board",
                "key": "WLAN_CHIP"
              }
            }
          ]
        }
      }
    },
    "current.chip": {
      "value": {
        "var": "reference.chip"
      }
    },
    "reference.ap": {
      "value": {
        "lower": {
          "coalesce": [
            {
              "input": "board_platform"
            },
            {
              "assignment": {
                "file": "reference.vendor.board",
                "key": "TARGET_BOARD_PLATFORM"
              }
            }
          ]
        }
      }
    },
    "current.ap": {
      "value": {
        "coalesce": [
          {
            "input": "current_board_platform"
          },
          {
            "var": "log.board"
          },
          {
            "var": "reference.ap"
          }
        ]
      }
    },
    "current.firmware": {
      "value": {
        "lookup": {
          "table": "firmware",
          "key": {
            "var": "current.chip"
          }
        }
      }
    }
  },
  "files": {
    "reference.system.board": {
