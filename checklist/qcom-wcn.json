                }
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "vendor.board",
      "title": "Reference Bluetooth and WLAN board settings",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B18"
      },
      "steps": [
        {
          "op": "make.ensure",
          "from": {
            "file": "reference.vendor.board"
          },
          "to": {
            "file": "current.vendor.board"
          },
          "select": {
            "assignment_names": [
              "WLAN_VENDOR",
              "WLAN_CHIP",
              "BOARD_HAVE_BLUETOOTH",
              "BOARD_HAVE_BLUETOOTH_QCOM",
              "BLUETOOTH_UART_DEVICE_PORT",
              "BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR"
            ]
