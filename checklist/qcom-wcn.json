  "rules": [
    {
      "id": "system.header",
      "title": "Copy missing reference build header",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B4"
      },
      "steps": [
        {
          "op": "file.copy_if_missing",
          "from": {
            "file": "reference.system.header"
          },
          "to": {
            "file": "current.system.header"
          },
          "policy": {
            "on_source_missing": "skip"
          },
          "pairing": {
            "method": "view_relative",
            "replacements": [
              [
                {
                  "var": "reference.common"
                },
                {
                  "var": "current.common"
                }
              ],
              [
                {
                  "var": "reference.model"
                },
                {
                  "var": "current.model"
                }
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "system.board",
      "title": "Reference Bluetooth and WLAN board settings",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B6"
      },
      "steps": [
        {
          "op": "make.ensure",
          "from": {
            "file": "reference.system.board"
          },
          "to": {
            "file": "current.system.board"
          },
          "select": {
            "assignment_names": [
              "WLAN_VENDOR",
              "WLAN_CHIP",
              "BOARD_HAVE_BLUETOOTH",
              "BOARD_HAVE_BLUETOOTH_QCOM",
              "BLUETOOTH_UART_DEVICE_PORT",
              "BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ]
    },
    {
      "id": "system.packages",
      "title": "Reference Bluetooth packages",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B8"
      },
      "steps": [
        {
          "op": "make.packages",
          "from": {
            "file": "reference.system.packages"
          },
          "to": {
            "file": "current.system.packages"
          },
          "select": {
            "variable": "PRODUCT_PACKAGES",
            "names": [
              "BluetoothAgent"
            ]
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          }
        }
      ]
    },
    {
      "id": "system.features",
      "title": "Reference Bluetooth product features",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B10"
      },
      "steps": [
        {
          "op": "make.values",
          "from": {
            "file": "reference.system.features"
          },
          "to": {
            "file": "current.system.features"
          },
          "select": {
            "prefix": "SEC_PRODUCT_FEATURE_BLUETOOTH_"
          },
          "policy": {
            "on_source_missing": "review",
            "on_empty_selection": "review"
          },
          "operator": "="
        }
      ]
    },
    {
      "id": "vendor.header",
      "title": "Copy missing reference build header",
      "provenance": {
        "sheet": "QCOM-WCN",
        "range": "B16"
      },
      "steps": [
